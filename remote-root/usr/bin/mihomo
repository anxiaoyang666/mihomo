#!/bin/bash
# main.sh - Mihomo 命令行管理工具 v1.0.3
# 安装路径: /usr/bin/mihomo

MIHOMO_DIR="/etc/mihomo"
SCRIPT_DIR="${MIHOMO_DIR}/scripts"
ENV_FILE="${MIHOMO_DIR}/.env"
LOG_FILE="/var/log/mihomo.log"

SVC_CORE="mihomo.service"
SVC_MANAGER="mihomo-manager.service"
CORE_BIN="/usr/bin/mihomo-core"

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[0;33m'; BLUE='\033[0;34m'; NC='\033[0m'
if [ -f "$ENV_FILE" ]; then source "$ENV_FILE"; fi

# .env 写入统一走 scripts/envutil.sh 的 upsert_env（shlex 引用 + 0600 原子替换），这里不再复制一份
if [ -f "${SCRIPT_DIR}/envutil.sh" ]; then
    source "${SCRIPT_DIR}/envutil.sh"
else
    upsert_env() {
        echo -e "${RED}缺少 ${SCRIPT_DIR}/envutil.sh，无法写入 .env，请重新安装工具箱。${NC}" >&2
        return 1
    }
fi

check_status() {
    if systemctl is-active --quiet $SVC_CORE; then c="${GREEN}运行中${NC}"; else c="${RED}已停止${NC}"; fi
    if systemctl is-active --quiet $SVC_MANAGER; then m="${GREEN}运行中${NC}"; else m="${RED}已停止${NC}"; fi
    echo -e "内核: ${c} | 面板: ${m}"
}

get_version() {
    if [ -f "$CORE_BIN" ]; then $CORE_BIN -v | head -n 1 | awk '{print $3}'; else echo "未安装"; fi
}

view_log() {
    echo "打开日志... (Ctrl+C 退出)"
    [ -f "$LOG_FILE" ] && tail -f -n 50 "$LOG_FILE" || echo -e "${YELLOW}日志不存在${NC}"
}

# === 更新/修复内核：下载、校验、版本比较全部交给 install_kernel.sh（唯一实现，避免两套逻辑不一致）===
update_kernel() {
    echo "🔍 正在检查 GitHub 最新版本..."
    if [ ! -f "${SCRIPT_DIR}/install_kernel.sh" ]; then
        echo -e "${RED}❌ 缺少 ${SCRIPT_DIR}/install_kernel.sh，请重新安装工具箱。${NC}"
        return 1
    fi
    if bash "${SCRIPT_DIR}/install_kernel.sh" auto; then
        echo -e "${GREEN}🎉 内核已就绪，当前版本: $(get_version)${NC}"
    else
        echo -e "${RED}❌ 内核更新失败，已保留当前内核 ($(get_version))。${NC}"
        return 1
    fi
}

# 订阅链接写入的是 update_subscription.sh / 面板实际读取的键：CONFIG_MODE + SUB_URL_RAW / SUB_URL_AIRPORT
manage_sub() {
    echo -e "\n1. 粘贴订阅链接  2. 编辑 config.yaml"
    read -p "选择: " opt
    if [ "$opt" == "1" ]; then
        echo -e "订阅类型：\n  1. 配置托管 (链接返回完整的 mihomo config.yaml)\n  2. 节点订阅 (机场链接，套用本地模板)"
        read -p "类型 [1/2]: " kind
        read -p "链接: " url
        [ -n "$url" ] || { echo "链接为空，已取消。"; return; }
        if [ "$kind" == "2" ]; then
            upsert_env "CONFIG_MODE" "airport"
            upsert_env "SUB_URL_AIRPORT" "$url"
        else
            upsert_env "CONFIG_MODE" "raw"
            upsert_env "SUB_URL_RAW" "$url"
        fi
        # update_subscription.sh 自己会校验、备份并重启内核
        bash "${SCRIPT_DIR}/update_subscription.sh" && echo "✅ 已更新"
    elif [ "$opt" == "2" ]; then
        nano /etc/mihomo/config.yaml && read -p "重启生效? (y/n): " r && [ "$r" == "y" ] && systemctl restart $SVC_CORE
    fi
}

show_info() {
    IP=$(hostname -I | awk '{print $1}')
    echo -e "\n${BLUE}=== 面板信息 ===${NC}"
    echo -e "地址: http://${IP}:${WEB_PORT:-7838}"
    echo -e "用户: ${WEB_USER}"
    echo -e "密码: ${WEB_SECRET}"
    echo -e "内核控制器 (Dashboard): http://${IP}:9090/ui"
    echo -e "控制器密钥 (MIHOMO_API_SECRET): ${MIHOMO_API_SECRET:-未设置}"
    echo -e "${BLUE}===============${NC}"
}

# 卸载：实际清理逻辑在 scripts/uninstall.sh（和 install.sh / gateway_init.sh 一一对应），这里只做菜单确认
uninstall_toolbox() {
    read -p "确认卸载? (y/n): " ack
    [ "$ack" == "y" ] || return
    read -p "同时删除 /etc/mihomo 下的配置和数据? (y/n): " purge
    local data_flag="--keep-data"
    [ "$purge" == "y" ] && data_flag="--purge"
    if [ -f "${SCRIPT_DIR}/uninstall.sh" ]; then
        bash "${SCRIPT_DIR}/uninstall.sh" -y "$data_flag"
        exit 0
    fi
    # uninstall.sh 丢了也要能卸干净
    systemctl stop mihomo mihomo-manager force-ip-forward 2>/dev/null
    systemctl disable mihomo mihomo-manager force-ip-forward 2>/dev/null
    rm -f /etc/systemd/system/mihomo.service /etc/systemd/system/mihomo-manager.service /etc/systemd/system/force-ip-forward.service
    systemctl daemon-reload
    local tmp_cron
    tmp_cron="$(mktemp)"
    crontab -l 2>/dev/null | grep -F -v -- "gateway_init.sh" | grep -F -v -- "MIHOMO_AUTOMATION" | grep -F -v -- "# JOB_SUB" | grep -F -v -- "# JOB_GEO" | grep -F -v -- "MIHOMO_AUTO_UPDATE" | grep -F -v -- "/etc/mihomo/manager/auto_update.py" | grep -F -v -- "/etc/mihomo/scripts/" > "$tmp_cron" || true
    if [ -s "$tmp_cron" ]; then crontab "$tmp_cron"; else crontab -r 2>/dev/null || true; fi
    rm -f "$tmp_cron"
    rm -f /etc/sysctl.d/99-mihomo-gateway.conf /etc/logrotate.d/mihomo /usr/bin/mihomo /usr/bin/mihomo-core /usr/bin/mihomo-core.new
    rm -f /var/log/mihomo-auto-update.log /run/mihomo-auto-update.lock
    [ "$data_flag" == "--purge" ] && rm -rf /etc/mihomo
    echo "已卸载"
    exit 0
}

show_menu() {
    clear
    echo -e "${BLUE}===========================================${NC}"
    echo -e "${BLUE}       Mihomo 管理工具         ${NC}"
    echo -e "${BLUE}===========================================${NC}"
    echo -e " 运行状态: $(check_status)"
    echo -e " 内核版本: $(get_version)"
    echo -e "${BLUE}-------------------------------------------${NC}"
    echo -e " 1. 更新/修复 Mihomo 内核 (Update Core)"
    echo -e " 2. 服务管理 (启动/停止/重启)"
    echo -e " 3. 配置与订阅 (设置链接/手动配置)"
    echo -e " 4. 查看实时日志"
    echo -e " 5. 自动化任务 (Crontab)"
    echo -e " 6. 更新 Geo 数据库"
    echo -e " 7. 通知的配置与测试"
    echo -e " 8. 初始化网关网络 (Tun)"
    echo -e " 9. 查看面板信息"
    echo -e "${RED}10. 卸载 Mihomo 工具箱${NC}"
    echo -e " 0. 退出脚本"
    echo -e "${BLUE}===========================================${NC}"
}

case $1 in
    start) systemctl start $SVC_MANAGER $SVC_CORE; exit ;;
    stop) systemctl stop $SVC_MANAGER $SVC_CORE; exit ;;
    restart) systemctl restart $SVC_MANAGER $SVC_CORE; exit ;;
    log) view_log; exit ;;
esac

while true; do
    show_menu
    read -p "请输入选项 [0-10]: " c
    case $c in
        1) update_kernel; read -n 1 -s -r -p "按键返回..." ;;
        2) 
            echo "1.启动 2.停止 3.重启"
            read -p "选择: " s
            case $s in
                1) systemctl start $SVC_MANAGER $SVC_CORE ;;
                2) systemctl stop $SVC_MANAGER $SVC_CORE ;;
                3) systemctl restart $SVC_MANAGER $SVC_CORE ;;
            esac
            sleep 1 ;;
        3) manage_sub; read -n 1 -s -r -p "按键返回..." ;;
        4) view_log ;;
        5) crontab -l 2>/dev/null | grep -E "mihomo|JOB_SUB|JOB_GEO|MIHOMO_AUTOMATION|MIHOMO_AUTO_UPDATE"; read -n 1 -s -r -p "按键返回..." ;;
        6) bash "${SCRIPT_DIR}/update_geo.sh"; read -n 1 -s -r -p "按键返回..." ;;
        7) bash "${SCRIPT_DIR}/notify.sh" --event info "通知测试" "通知通道正常"; read -n 1 -s -r -p "按键返回..." ;;
        8) bash "${SCRIPT_DIR}/gateway_init.sh"; read -n 1 -s -r -p "按键返回..." ;;
        9) show_info; read -n 1 -s -r -p "按键返回..." ;;
        10) uninstall_toolbox ;;
        0) exit 0 ;;
        *) echo "无效选项"; sleep 1 ;;
    esac
done
